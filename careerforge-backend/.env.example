# Server
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/career-platform

# Auth
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Environment
NODE_ENV=development

# Redis (Phase 2)
# Local:  redis://localhost:6379
# Redis Cloud: redis://default:<password>@<host>:<port>  (from the Redis Cloud "redis-cli" connection string)
REDIS_URL=redis://localhost:6379

# AI (Phase 2)
# Free Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (Optional, unused for now) Anthropic Claude key placeholder
ANTHROPIC_API_KEY=

# Stripe (Bonus)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SSLCommerz (Bonus)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# Cloudinary (Phase 2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sentry (Phase 2)
SENTRY_DSN=
